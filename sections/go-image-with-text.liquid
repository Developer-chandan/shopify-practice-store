{% liquid
  assign color_scheme = section.settings.color_scheme
  assign padding_top = section.settings.padding_top
  assign padding_bottom = section.settings.padding_bottom
  assign section_gap = section.settings.section_gap
  assign product_image = section.settings.product_image
  assign section_title = section.settings.section_title
%}


<style>
    .main_section_wrapper{
    padding-top: {{ padding_top }}px;
    padding-bottom: {{ padding_bottom }}px;
    }
   
    .image_and_text_wrap{
      display: flex;
      gap: {{ section_gap }}px;

    }
    .details_wrap{
     display: flex;
    }
</style>

<div class="main_section_wrapper color-{{ color_scheme }} gradiant">
  <div class="page-width">
    <div class="image_and_text_wrap">
      <div class="text_wrap">
        <h2 class="title">{{ section_title }}</h2>
        <div class="product_details">
          {% for block in section.blocks %}

            {% liquid
              assign deatils_icon = block.settings.svg_picker
              assign deatils_text = block.settings.details_text
            %}
            <div class="details_wrap">
              <div class="icon">
                {% if deatils_icon != blank %}
                
                    <img src="{{deatils_icon | image_url:width:150  }}" width="" height="" alt="">
               
                {% else %}
                  {{ 'image' | placeholder_svg_tag }}
                {% endif %}
              </div>
              <div class="details">
                <p> {{ deatils_text }}</p>
              </div>
            </div>
          {% endfor %}
        </div>
      </div>
      <div class="image_wrap">
         {% if product_image%}
                  
                    <img src="{{product_image | image_url:width:450  }}" width="" height="" alt="">
                
                {% else %}
                  {{ 'image' | placeholder_svg_tag }}
                {% endif %}
      </div>
    </div>
  </div>
</div>




{% schema %}
{
  "name": "Image with Text",
  "class": "go_image_with_text",
  "settings": [
    {
     "type": "color_scheme",
     "id": "color_scheme",
     "label": "Color Scheme"
    },
    {
     "type": "range",
     "id": "padding_top",
     "min": 10,
     "max": 120,
     "step": 10,
     "default": 80,
     "label": "Padding Top"
    },
    {
     "type": "range",
     "id": "padding_bottom",
     "min": 10,
     "max": 120,
     "step": 10,
     "default": 80,
     "label": "Padding Bottom"
    },

    {
     "type": "range",
     "id": "section_gap",
     "min": 10,
     "max": 100,
     "step": 10,
     "default": 40,
     "label": "Section Gap"
    },
    {
    "type": "image_picker",
    "id": "product_image",
    "label": "Product Image"
    },
    {
     "type": "text",
     "id": "section_title",
     "label": "Section Title",
     "default": "Craft Deli-Grade Pickles in 3 Easy Steps"
    }








  ],
  "blocks": [
    {
     "type": "details",
     "name": "Product Details",
     "limit": 5,
     "settings": [
        {
         "type": "image_picker",
         "id": "svg_picker",
         "label": "Upload Icon"
        },
        {
         "type": "text",
         "id": "details_text",
         "label": "Text",
         "default": "Choose your fresh cucumbers ( Kirby’s or Gherkin’s are best)."
        }
     ]
    }
  ],
  "presets": [
    {
      "name": "Gopickle Image with Text"
    }
  ]
}
{% endschema %}
