{% liquid 
 assign padding_bottom = section.settings.padding_bottom

%}
 

<style>



    .product_wrapper{
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 40px;

    }
    .product_card{
        flex-basis: 33.33%;
        text-align: center;
    }

    .product_title h4{
        font-size: 20px;
        line-height: 28px;
        font-weight: 600;
    }
    .product_cards_title{
        text-align: center;
        padding-top: 35px;
        padding-bottom: 35px;
    }
    
    .description p{
      font-size: 16px;
      line-height: 22px;
      font-weight: 500;
      color: black;
    }
    .product_card_main_wrap{
        padding-bottom: {{padding_bottom}}px;
    }


    @media(max-width: 768px){
       .product_wrapper{
        flex-direction: column;

    }

.product_card .image{
  display: flex;
  justify-content: center;
  align-items: center;
}

    }


</style>



<div class="color-{{ section.settings.color_scheme }} gradiant product_card_main_wrap">
  <div class="product_cards_title">
    <h2 class="title">Our Winning Organic Spice Blends</h2>
  </div>
  <div class="page-width">
    <div class="product_wrapper">
      {% for block in section.blocks %}
        {% liquid
          assign product_image = block.settings.product_image
          assign product_title = block.settings.product_title
          assign product_desc = block.settings.product_desc
          assign link = block.settings.product_link
        %}
        <div class="product_card">
          <div class="image">
            {% if product_image %}
              
                <a href="{{ link }}">
                  <img src="{{product_image | image_url:width:450  }}" width="" height="" alt="">
                </a>
            {% else %}
                    {{ 'image' | placeholder_svg_tag }}
                    
            {% endif %}
          </div>
          <div class="product_title">
            <h4>
              <a href="{{link}}">

                {{ product_title }}
              </a>
            </h4>
          </div>
          <div class="description">
            <p>{{ product_desc }}</p>
          </div>
        </div>
      {% endfor %}
      <div class="swiper-pagination"></div>

    </div>
  </div>
</div>



{% schema %}
{
  "name": "Go Pickle Product Cards",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "color_scheme",
      "default": "scheme-7"
    },
    {
     "type": "range",
     "label": "Padding Top",
     "min": 15,
     "max": 100,
     "step": 5,
     "id": "padding_top",
     "default": 25,
     "unit": "px"
    },
    {
     "type": "range",
     "label": "Padding Bottom",
     "min": 15,
     "max": 150,
     "step": 5,
     "id": "padding_bottom",
     "default": 100,
     "unit": "px"
    }
  ],
  "blocks": [
    {
      "name": "Product Card",
      "type": "product_cards",
      "limit": 3,
      "settings": [
        {
          "type": "image_picker",
          "id": "product_image",
          "label": "Product Image"
        },
        {
          "type": "text",
          "id": "product_title",
          "default": "The Real Dill",
          "label": "Product Title"
        },
        {
          "type": "text",
          "id": "product_desc",
          "default": "Himalayan Pink Salt, Dried Dill, Organic Dried Garlic, Mustard Seeds, Peppercorns, Coriander Seeds, Dried Chili, Dried Bay Leaves.",
          "label": "Product Title"
        },
        {
         "type": "url",
         "label": "Product Link",
         "id": "product_link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Go Products Cards"
    }
  ]
}
{% endschema %}


