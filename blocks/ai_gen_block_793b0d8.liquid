    },
    {
      "type": "range",
      "id": "star_1_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Star 1 top position",
      "default": 10
    },
    {
      "type": "range",
      "id": "star_1_left",
