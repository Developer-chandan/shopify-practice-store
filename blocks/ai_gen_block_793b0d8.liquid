    {
      "type": "text",
      "id": "stat_2_number",
      "label": "Stat 2 number",
      "default": "50+"
    },
    {
      "type": "text",
      "id": "stat_2_label",
      "label": "Stat 2 label",
      "default": "Countries"
    },
    {
      "type": "text",
      "id": "stat_3_number",
      "label": "Stat 3 number",
      "default": "99%"
